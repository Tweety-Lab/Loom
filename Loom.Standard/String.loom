import Standard::Memory;

module Standard
{
	// Its a little strange that we make string lowercase like C#, but it enforces it as a base type.
	// Worth checking back on though.

	export class string : IStringFormattable, ICloneable<string>
	{
		/// @brief The amount of characters in this string.
		public i32 Length
		{
			get
			{
				return characters.Count;
			}
		}

		Vector<char> characters = default;

		/// @brief Initializes a new empty string.
		public string()
		{
			characters = new Vector<char>();
		}

		/// @brief Initializes a new string from a slice of characters.
		public string(Slice<char> slice)
		{
			characters = new Vector<char>(slice.Length);

			for (i32 i = 0; i < slice.Length; i++)
				characters.Add(slice[i]);
		}

		/// @brief Initializes a new string from a vector of characters.
		public string(ref Vector<char> vector)
		{
			characters = new Vector<char>(vector.Count);

			for (i32 i = 0; i < vector.Count; i++)
				characters.Add(vector[i]);
		}

		/// @inheritdoc
		public unique string ToString()
		{
			return new string(characters.Clone());
		}

		/// @inheritdoc
		public unique string Clone()
		{
			return new string(characters.Clone());
		}

#region Operators
		/// @brief Gets the character at the specified index.
		/// @param(index) The index of the element to return.
		/// @return The character at the specified index.
        public static char operator[](ref string str, i32 index)
        {
			return str.characters[index];
        }

		/// @brief Adds two strings together.
		/// @return New string containing the result.
		public static unique string operator+(ref string left, ref string right)
		{
			unique Vector<char> characters = new Vector<char>(left.characters.Count + right.characters.Count);
			characters.AddRange(left.characters);
			characters.AddRange(right.characters);
			return new string(characters);
		}

		/// @brief Adds a char slice to a string.
		/// @return New string containing the result.
		public static unique string operator+(Slice<char> left, ref string right)
		{
			unique Vector<char> characters = new Vector<char>(left.Length + right.characters.Count);
			for (i32 i = 0; i < left.Length; i++)
				characters.Add(left[i]);

			characters.AddRange(right.characters);
			return new string(characters);
		}

		/// @brief Adds a string to a char slice.
		/// @return New string containing the result.
		public static unique string operator+(ref string left, Slice<char> right)
		{
			unique Vector<char> characters = new Vector<char>(left.characters.Count + right.Length);
			characters.AddRange(left.characters);
			for (i32 i = 0; i < right.Length; i++)
				characters.Add(right[i]);

			return new string(characters);
		}
#endregion
	}

	/// @brief Defines a type that can be converted to a string.
	/// @remark String formattable types can be used in string interpolation.
	export interface IStringFormattable
	{
		/// @brief Converts this instance to a string.
		/// @return String representation of the instance.
		unique string ToString();
	}
}
