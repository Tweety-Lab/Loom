module Standard::Memory
{
    /// @brief Provides unsafe memory operations.
    /// @remark This class can only be used inside of an `unsafe` block.
    export static class Unsafe
    {
        /// @brief The heap allocator unsafe operations use.
        public static DefaultAllocator Allocator { get; set; }

        /// @brief Allocates memory of the given size.
		/// @param(size) The size of the memory to allocate.
        /// @return The address of the allocated memory.
        public static iptr Allocate(i64 size)
        {
            unsafe
            {
                return Allocator.Allocate(size);
            }
        }

		/// @brief Frees the memory at the given address.
        public static void Free(iptr address)
        {
            unsafe
            {
                Allocator.Free(address);
            }
        }

#region Intrinsics
        /// @brief Gets the memory address of the given value.
		/// @param(value) The value to get the address of.
		/// @return The memory address of the given value.
        public static extern iptr AddressOf<T>(ref T value);

        /// @brief Reads the value at the given address.
		/// @param(address) The address to read from.
		/// @return The value at the given address.
        public static extern unique T Read<T>(iptr address);

		/// @brief Writes the value to the given address.
		/// @param(address) The address to write to.
		/// @param(value) The value to write.
		public static extern void Write<T>(iptr address, T value);
#endregion
    }
}