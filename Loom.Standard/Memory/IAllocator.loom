module Standard::Memory
{
	/// @brief Defines how heap memory is allocated and freed.
	export interface IAllocator
	{
		/// @brief Allocates memory of the given size.
		/// @param(size) The size of the memory to allocate.
		/// @return A pointer to the allocated memory.
		iptr Allocate(i64 size);

		/// @brief Frees the memory at the given address.
		/// @param(address) The address of the memory to free.
		void Free(iptr address);
	}

	extern iptr malloc(i64 size);
	extern void free(iptr address);

	export struct DefaultAllocator : IAllocator
	{
		/// @inheritdoc
        public iptr Allocate(i64 size)
        {
            return malloc(size);
        }

		/// @inheritdoc
        public void Free(iptr address)
        {
			free(address);
        }
	}
}