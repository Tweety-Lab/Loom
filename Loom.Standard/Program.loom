import Standard;
import Standard::IO;
import Standard::Memory;
import Standard::Reflection;

module Standard::Program
{
    export interface IMyInterface
    {
        void Test();
    }

    /// @brief Classes are reference types and are interfaced with through Loom's ownership and memory model (smart pointers)!
    export class Object : IMyInterface
    {
        public i32 MutableField { get; set; } = default;

        public void Test()
        {
            println("Gurt");
        }
    }

    export enum PrintType
    {
        Print,
        DontPrint
    }

    /// @brief Program Entry Point.
    export i32 Main()
    {
        // A Unique pointer to an object can only have one owner at a time
        unique IMyInterface obj = new Object();
        // obj.Test();

        // 'Slice<T>' doesn't need to use pointers because it's a value type (struct)
        // Value types use copy semantics and typically live on the stack
        Slice<char> myString = "Hello!";
        println(myString); // "Hello!"

        Slice<char> window = myString.Subslice(2, 3);
		println(window); // "llo"

        Slice<char> rangedWindow = myString[0..3];
		println(rangedWindow); // "Hel"

        unique string name = "Project: " + Assembly.Current.Name;
        println(name); // "Project: Loom.Standard"

        // Loom also allows unsafe operations inside an 'unsafe' block via the 'Standard::Memory::Unsafe' class
        unsafe
        {
            char[3] myArray = ['a', 'b', 'c'];
            iptr addr = Unsafe.AddressOf<char[3]>(myArray);

            char letter = Unsafe.Read<char>(addr + sizeof(char) * 2);
            println(letter); // "c"
        }
        
        unique Vector<i32> vec = [10, 3, 6, 64, 12];

        OptionalPrint(PrintType.Print);
        
        return vec[2];
    }

    export bool OptionalPrint(PrintType type)
    {
        if (type == PrintType.Print)
        {
            println("Printing!");
            return true;
        }

        return false;
    }
}


