import Standard::Memory;
import Standard;

module Standard::IO
{
	extern void putchar(char c);

    /// @brief Prints a char slice to the console and appends a newline.
    export void println(Slice<char> s)
    {
        print(s);
		print('\n');
    }

    /// @brief Prints a char vector to the console and appends a newline.
	export void println(ref Vector<char> v)
	{
		print(v);
		print('\n');
	}

	/// @brief Prints a string to the console and appends a newline.
	export void println(ref string s)
	{
		print(s);
		print('\n');
	}

	/// @brief Prints a char to the console and appends a newline.
    export void println(char c)
    {
		print(c);
		print('\n');
    }

	/// @brief Prints a char slice to the console.
    export void print(Slice<char> s)
    {
        for (i32 i = 0; i < s.Length; i++)
            print(s[i]);
    }

	/// @brief Prints a char vector to the console.
    export void print(ref Vector<char> v)
	{
        for (i32 i = 0; i < v.Count; i++)
			print(v[i]);
	}

	/// @brief Prints a string to the console.
	export void print(ref string s)
	{
		for (i32 i = 0; i < s.Length; i++)
			print(s[i]);
	}

	/// @brief Prints a char to the console.
    export void print(char c)
	{
		putchar(c);
	}
}