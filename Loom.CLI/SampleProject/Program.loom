import Windows;

module Consumer
{
    /// @brief Program Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;
        
        Process process = Process.Current();
        Process copy = process;

        if (copy.Handle == process.Handle)
            exitCode = 2;
        
        return true;
    }
}

module Windows
{
#region Native
    extern iptr GetCurrentProcess();
    extern bool TerminateProcess(iptr process, i32 exitCode);
#endregion
    
	/// @brief Native Windows Process
    export struct Process
    {
        public iptr Handle = default;

        /// @brief Closes the process
        public bool Close()
        {
            return TerminateProcess(Handle, 0);
        }

        /// @brief Gets the current process
        /// @return The current process
        public static Process Current()
        {
            Process process = new Process();
            process.Handle = GetCurrentProcess();
            return process;
        }
    }
}
