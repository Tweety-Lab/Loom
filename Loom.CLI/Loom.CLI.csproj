<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loom.Analyzer\Loom.Analyzer.csproj" />
    <ProjectReference Include="..\CodeGen\Loom.CodeGen.LLVM\Loom.CodeGen.LLVM.csproj" />
    <ProjectReference Include="..\Loom.Common\Loom.Common.csproj" />
    <ProjectReference Include="..\Loom.LIR\Loom.LIR.csproj" />
    <ProjectReference Include="..\Loom.Parser\Loom.Parser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="SampleProject\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="sampleproject\SampleProject.lmproj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="SampleProject\Program.loom">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="SampleProject\Windows.loom">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
