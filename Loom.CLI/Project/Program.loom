import Windows;

module Consumer
{
    // Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;

        Process process = GetProcess();
        if (process.Close())
            exitCode = 0;
        
        return exitCode;
    }
}

module Windows
{
    extern iptr GetCurrentProcess();
    extern bool TerminateProcess(iptr process, i32 exitCode);

    export struct Process
    {
        iptr Handle = default;

        bool Close()
        {
            return TerminateProcess(Handle, 0);
        }
    }

    export Process GetProcess()
    {
        Process process = new Process();
        process.Handle = GetCurrentProcess();
        return process;
    }
}
