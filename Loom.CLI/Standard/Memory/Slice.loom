module Standard::Memory
{
	/// @brief Immutable unowning slice of contiguous memory.
    export stack struct Slice<T>
    {
        /// @brief The number of elements in the slice.
        public i32 Length { get; } = default;

        iptr pointer = default;

        /// @brief Returns the element at the specified index.
		/// @param index The index of the element to return.
		/// @return The element at the specified index.
        public static unique T operator[](Slice<T> slice, i32 index)
        {
            unsafe
            {
                return Unsafe.Read<T>(slice.pointer + index * sizeof(T));
            }
        }
    }
}
