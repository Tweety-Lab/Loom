import Standard::Memory;

module Standard
{
	/// @brief Dynamically sized continuous storage of objects.
	/// @tparam T The type of objects stored in the vector.
	export class Vector<T>
	{
		/// @brief The number of elements currently stored in the \ref Vector.
		public i32 Count { get; } = default;

		/// @brief The maximum number of elements that can be stored in the \ref Vector before it needs to be resized.
		public i32 Capacity { get; } = 4;

		iptr pointer = default;

		public Vector()
		{
			unsafe
			{
				pointer = Unsafe.Allocate(Capacity * sizeof(T));
			}
		}

		public Vector(i32 capacity)
		{
			Capacity = capacity;

			unsafe
			{
				pointer = Unsafe.Allocate(Capacity * sizeof(T));
			}
		}

		~Vector()
		{
			unsafe
			{
				Unsafe.Free(pointer);
			}
		}

		/// @brief Adds an element to the end of the \ref Vector.
		/// @param element The element to add to the \ref Vector.
		public void Add(T element)
		{
			if (Count >= Capacity)
			{
				Capacity = Capacity * 2;

				unsafe
				{
					iptr newPointer = Unsafe.Allocate(Capacity * sizeof(T));
					for (i32 i = 0; i < Count; i++)
					{
						unique T value = Unsafe.Read<T>(pointer + i * sizeof(T));
						Unsafe.Write<T>(newPointer + i * sizeof(T), value);
					}

					Unsafe.Free(pointer);
					pointer = newPointer;
				}
			}

			unsafe
			{
				Unsafe.Write<T>(pointer + Count * sizeof(T), element);
			}

			Count++;
		}

		/// @brief Returns the element at the specified index.
		/// @param index The index of the element to return.
		/// @return The element at the specified index.
        public static unique T operator[](Vector<T> slice, i32 index)
        {
            unsafe
            {
                return Unsafe.Read<T>(slice.pointer + index * sizeof(T));
            }
        }
	}
}
