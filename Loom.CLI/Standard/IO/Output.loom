import Standard;

module Standard::IO
{
	extern void putchar(char c);

    /// @brief Prints a string to stdout and appends a newline.
    export void println(String s)
    {
        i32 currentChar = 0;

        while (currentChar < s.Length)
        {
            putchar(s.Characters[currentChar]);
            currentChar = currentChar + 1;
        }

		putchar('\n');
    }
}