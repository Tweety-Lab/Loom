import Standard::Memory;

module Standard
{
	/// @brief Immutable unowning slice of contiguous memory.
    export stack struct Slice
    {
        /// @brief The number of elements in the slice.
        public i32 Length = default;

        iptr pointer = default;

        /// @brief Returns the element at the given index.
        public T ElementAt<T>(i64 index)
        {
            unsafe
            {
                return Unsafe.Read<T>(pointer + index * sizeof(T));
            }
        }
    }
}