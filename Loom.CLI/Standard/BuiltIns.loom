import Standard::Memory;

module Standard
{
    /// @brief Placeholder String type that uses a char array.
    export class String
    {
        public char[128] Characters = default;
        public i32 Length = default;

        public String(char[128] characters, i32 length)
        {
			Characters = characters;
			Length = length;
        }
    }

	/// @brief Immutable unowning slice of contiguous memory.
    export struct Slice
    {
        iptr pointer = default;
        i32 length = default;

        public Slice(iptr _pointer, i32 _length)
        {
            pointer = _pointer;
			length = _length;
        }

        /// @brief Returns the element at the given index.
        public T ElementAt<T>(i64 index)
        {
			return Unsafe.Read<T>(pointer + index * sizeof(T));
        }
    }
}