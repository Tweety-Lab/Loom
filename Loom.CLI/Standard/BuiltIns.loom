import Standard::IO;

module Standard
{
    /// @brief Placeholder String type that uses a char array.
    export class String
    {
        public char[128] Characters = default;
        public i32 Length = default;
    }

	/// @brief Immutable unowning slice of contiguous memory.
    export struct Slice
    {
        iptr pointer = default;
        i32 length = default;

        public Slice(iptr _pointer, i32 _length)
        {
            pointer = _pointer;
			length = _length;
        }
    }
}