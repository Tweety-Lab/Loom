import Standard::Windows;
import Standard::Time;
import Standard::IO;
import Standard;

module Standard::Program
{
    /// @brief Program Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;

        unique String str = new String();
        str.Contents[0] = 'H';
		str.Contents[1] = 'e';
		str.Contents[2] = 'l';
		str.Contents[3] = 'l';
		str.Contents[4] = 'o';
        
        WinProcess process = WinProcess.Current();
        WinProcess copy = process;

        if (copy.Handle != process.Handle)
            process.Close();

        if (copy.Handle == process.Handle)
        {
            exitCode = 0;

            print(str);

            Sleep(2000);
        }
        
        return exitCode;
    }
}