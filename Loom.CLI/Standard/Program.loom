import Standard::Windows;
import Standard::Time;
import Standard::IO;
import Standard;

module Standard::Program
{
    /// @brief Program Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;

        unique String myString = new String();
        myString.Characters = ['H', 'e', 'l', 'l', 'o', '!'];
        myString.Length = 6;

        myString.Characters[6] = '\0';
        
        WinProcess process = WinProcess.Current();

        if (process.Handle != default(iptr))
        {
            exitCode = 0;

            println(myString); // "Hello!"

            Sleep(2000);
            process.Close();
        }
        
        return exitCode;
    }
}