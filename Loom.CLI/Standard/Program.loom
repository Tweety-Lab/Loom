import Standard::IO;
import Standard::Memory;
import Standard;

module Standard::Program
{
    /// @brief Program Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;

        unique String string = GetClass();
        ConsumeClass(string);
        ConsumeClass(string);

        Slice myString = "Hello!";
        println(myString); // "Hello!"
        
        return 0;
    }

    export unique String GetClass()
	{
		return new String();
	}

    export void ConsumeClass(ref String input)
    {
        // We own input
    }
}