import Standard::Windows;
import Standard::Time;
import Standard::IO;

module Standard::Program
{
    /// @brief Program Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;

        MyClass instance = new MyClass();
        
        WinProcess process = WinProcess.Current();
        WinProcess copy = process;

        if (copy.Handle != process.Handle)
            process.Close();

        if (copy.Handle == process.Handle)
        {
            exitCode = 0;

            char character = 'T';
            putchar(character);

            Sleep(2000);
        }
        
        return instance.Number();
    }

    export class MyClass
    {
        i32 Number()
        {
            return 13;
        }
    }
}