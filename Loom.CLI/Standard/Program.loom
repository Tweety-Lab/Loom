import Standard::Windows;
import Standard::Time;
import Standard::IO;

module Standard::Program
{
    /// @brief Program Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;

        char[6] testArray = default;
        testArray[0] = 'H';
        testArray[1] = 'e';
        testArray[2] = 'l';
        testArray[3] = 'l';
        testArray[4] = 'o';
        testArray[5] = '\0';


        unique MyClass instance = new MyClass();
        
        WinProcess process = WinProcess.Current();
        WinProcess copy = process;

        if (copy.Handle != process.Handle)
            process.Close();

        if (copy.Handle == process.Handle)
        {
            exitCode = 0;

            putchar(testArray[0]);
            putchar(testArray[1]);
			putchar(testArray[2]);
			putchar(testArray[3]);
			putchar(testArray[4]);

            Sleep(2000);
        }
        
        return instance.Number();
    }

    export class MyClass
    {
        i32 Number()
        {
            return 13;
        }
    }
}