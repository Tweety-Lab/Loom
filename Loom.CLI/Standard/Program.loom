import Standard::Windows;
import Standard::Time;
import Standard::IO;

module Standard::Program
{
    /// @brief Program Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;

        TestClass myClass = new TestClass();
        
        WinProcess process = WinProcess.Current();
        WinProcess copy = process;

        if (copy.Handle != process.Handle)
            process.Close();

        if (copy.Handle == process.Handle)
        {
            exitCode = 0;

            char character = 'T';
            putchar(character);

            Sleep(2000);
        }
        
        return exitCode;
    }

    export class TestClass
    {
        public i32 Val = default;
    }
}