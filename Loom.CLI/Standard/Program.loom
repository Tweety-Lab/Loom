import Standard::IO;
import Standard::Memory;
import Standard;

module Standard::Program
{
    /// @brief Program Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;

        char[128] contents = ['H', 'e', 'l', 'l', 'o', '!'];

        unique String myString = new String(contents, 6);

        iptr addr = Unsafe.AddressOf<char[128]>(contents);
        Slice slice = new Slice(addr, 6);

        println(myString); // "Hello!"

        return 0;
    }
}