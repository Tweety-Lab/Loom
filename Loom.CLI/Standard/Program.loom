import Standard::Windows;
import Standard::Time;
import Standard::IO;
import Standard;

module Standard::Program
{
    /// @brief Program Entry Point
    export i32 Main()
    {
        i32 exitCode = 1;

        unique String myString = new String();
        myString.Characters[0] = 'H';
		myString.Characters[1] = 'e';
		myString.Characters[2] = 'l';
		myString.Characters[3] = 'l';
		myString.Characters[4] = 'o';
        myString.Characters[5] = '!';
        myString.Length = 6;
        
        WinProcess process = WinProcess.Current();

        if (process.Handle != default(iptr))
        {
            exitCode = 0;

            println(myString); // "Hello!"

            Sleep(2000);
            process.Close();
        }
        
        return exitCode;
    }
}