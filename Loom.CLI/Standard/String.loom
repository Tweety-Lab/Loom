import Standard::Memory;

module Standard
{
	// Its a little strange that we make string lowercase like C#, but it enforces it as a base type.
	// Worth checking back on though.

	export class string
	{
		Vector<char> characters = default;

		/// @brief Initializes a new empty string.
		public string()
		{
			characters = new Vector<char>();
		}

		/// @brief Initializes a new string from a slice of characters.
		public string(Slice<char> slice)
		{
			characters = new Vector<char>(slice.Length);

			for (i32 i = 0; i < slice.Length; i++)
				characters.Add(slice[i]);
		}
	}
}