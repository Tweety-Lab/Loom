{
  "name": "Loom",
  "scopeName": "source.loom",
  "fileTypes": [ "loom" ],

  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#new-expression" },
    { "include": "#keywords" },
    { "include": "#primitive-types" },
    { "include": "#constants" },
    { "include": "#generic-arguments" },
    { "include": "#generic-call" },
    { "include": "#generic-type" },
    { "include": "#qualifiers" },
    { "include": "#function-call" },
    { "include": "#type-annotation" },
    { "include": "#member" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],

  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.loom",
          "match": "//.*$"
        },
        {
          "name": "comment.block.loom",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "preprocessor": {
      "name": "meta.preprocessor.loom",
      "match": "^\\s*#\\w+\\b.*$",
      "captures": {
        "0": { "name": "keyword.control.directive.loom" }
      }
    },

    "strings": {
      "name": "string.quoted.double.loom",
      "begin": "\"",
      "end": "\"",
      "patterns": [ { "include": "#escapes" } ]
    },

    "characters": {
      "name": "string.quoted.single.loom",
      "begin": "'",
      "end": "'",
      "patterns": [ { "include": "#escapes" } ]
    },

    "escapes": {
      "name": "constant.character.escape.loom",
      "match": "\\\\(?:[\\\\'\"nrt0]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.loom",
          "match": "\\b(?:[0-9]+\\.[0-9]+|[0-9]+\\.(?![A-Za-z_.])|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.loom",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*)\\b"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(module|import)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_.]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.module.loom" },
            "2": { "name": "entity.name.namespace.loom" }
          }
        },
        {
          "match": "\\b(struct)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.struct.loom" },
            "2": { "name": "entity.name.type.struct.loom" }
          }
        },
        {
          "match": "\\b(class)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.class.loom" },
            "2": { "name": "entity.name.type.class.loom" }
          }
        }
      ]
    },

    "new-expression": {
      "match": "\\b(new)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.operator.new.loom" },
        "2": { "name": "entity.name.type.class.loom" }
      }
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.loom",
          "match": "\\b(?:if|else|while|for|break|continue|return)\\b"
        },
        {
          "name": "storage.modifier.loom",
          "match": "\\b(?:export|extern|unsafe|static|stack|public|private|unique|shared|weak)\\b"
        },
        {
          "name": "keyword.operator.expression.loom",
          "match": "\\b(?:sizeof|default)\\b"
        }
      ]
    },

    "primitive-types": {
      "name": "storage.type.primitive.loom",
      "match": "\\b(?:void|bool|i8|i16|i32|i64|u8|u16|u32|u64|char|iptr|f32|f64)\\b"
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.loom",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.loom",
          "match": "\\bnull\\b"
        }
      ]
    },

    "generic-arguments": {
      "comment": "A '<' glued to a word whose contents look like a type list and which closes with '>'. Recurses for nesting, e.g. Foo<Bar<T>, U>.",
      "name": "meta.generic.loom",
      "begin": "(?<=[A-Za-z0-9_])<(?=[\\w\\s,.*<>]*>)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.generic.begin.loom" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.generic.end.loom" }
      },
      "patterns": [
        { "include": "#primitive-types" },
        { "include": "#numbers" },
        { "include": "#generic-arguments" },
        { "include": "#qualifiers" },
        {
          "name": "punctuation.separator.comma.loom",
          "match": ","
        },
        {
          "name": "entity.name.type.loom",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "generic-call": {
      "comment": "Name<...>(  -> generic function call or declaration",
      "name": "entity.name.function.loom",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=<[\\w\\s,.*<>]*>\\s*\\()"
    },

    "generic-type": {
      "comment": "Name<...>  -> generic type usage",
      "name": "entity.name.type.loom",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=<[\\w\\s,.*<>]*>)"
    },

    "qualifiers": {
      "comment": "PascalCase identifier directly followed by '.' is treated as a class/namespace, e.g. Unsafe in Unsafe.Generic<T>()",
      "name": "entity.name.type.class.loom",
      "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*\\.\\s*[A-Za-z_])"
    },

    "function-call": {
      "name": "entity.name.function.loom",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },

    "type-annotation": {
      "comment": "Type followed by a name: 'Foo x', 'Foo* x', 'Foo name(' ... Keywords are matched earlier so they never reach this rule.",
      "name": "entity.name.type.loom",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\*{0,3}\\s+[A-Za-z_][A-Za-z0-9_]*\\s*[=;(),<\\[])"
    },

    "member": {
      "name": "variable.other.member.loom",
      "match": "(?<=\\.)\\s*[A-Za-z_][A-Za-z0-9_]*\\b"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.loom",
          "match": "==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|&&|\\|\\||[=+\\-*/%<>!&|]"
        },
        {
          "name": "punctuation.accessor.loom",
          "match": "\\."
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.begin.loom",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.block.end.loom",
          "match": "\\}"
        },
        {
          "name": "punctuation.definition.parameters.begin.loom",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.parameters.end.loom",
          "match": "\\)"
        },
        {
          "name": "punctuation.definition.array.begin.loom",
          "match": "\\["
        },
        {
          "name": "punctuation.definition.array.end.loom",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.comma.loom",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.loom",
          "match": ";"
        }
      ]
    },

    "identifiers": {
      "name": "variable.other.loom",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}