{
  "name": "Loom",
  "scopeName": "source.loom",
  "fileTypes": [
    "loom"
  ],

  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#modules"
    },
    {
      "include": "#structs"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],

  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.loom",
          "match": "//.*$"
        },
        {
          "name": "comment.block.loom",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "preprocessor": {
      "patterns": [
        {
          "name": "keyword.preprocessor.region.loom",
          "match": "^\\s*#\\w+\\b.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.loom",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.loom",
              "match": "\\\\(?:[\\\\\"'nrt0]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4})"
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.loom",
          "match": "\\b(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|[0-9]+)\\b"
        },
        {
          "name": "constant.numeric.float.loom",
          "match": "\\b(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?\\b"
        }
      ]
    },

    "modules": {
      "patterns": [

        {
          "name": "keyword.declaration.module.loom",
          "match": "\\bmodule\\b"
        },

        {
          "name": "keyword.control.import.loom",
          "match": "\\bimport\\b"
        }

      ]
    },

    "structs": {
      "patterns": [

        {
          "name": "keyword.declaration.struct.loom",
          "match": "\\bstruct\\b"
        },

        {
          "name": "entity.name.type.struct.loom",
          "match": "(?<=\\bstruct\\s+)[A-Za-z_][A-Za-z0-9_]*"
        }

      ]
    },

    "functions": {
      "patterns": [

        {
          "name": "entity.name.function.declaration.loom",
          "match": "(?<=\\b(?:void|bool|i8|i16|i32|i64|u8|u16|u32|u64|iptr|uptr|f32|f64)\\s+)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },

        {
          "name": "entity.name.function.declaration.loom",
          "match": "(?<=\\bexport\\s+(?:extern\\s+)?(?:void|bool|i8|i16|i32|i64|u8|u16|u32|u64|iptr|uptr|f32|f64)\\s+)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },

        {
          "name": "entity.name.function.call.loom",
          "match": "\\b(?!(?:if|else|while|for|break|continue|return)\\b)[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },

        {
          "name": "variable.parameter.loom",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*,|\\s*\\))"
        }

      ]
    },

    "keywords": {
      "patterns": [

        {
          "name": "keyword.control.loom",
          "match": "\\b(?:if|else|while|for|break|continue|return)\\b"
        },

        {
          "name": "storage.modifier.loom",
          "match": "\\b(?:export|extern|unsafe)\\b"
        },

        {
          "name": "storage.modifier.new.loom",
          "match": "\\bnew\\b"
        }

      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.loom",
          "match": "\\b(?:void|bool|i8|i16|i32|i64|u8|u16|u32|u64|iptr|f32|f64|default)\\b"
        },

        {
          "name": "entity.name.type.loom",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*\\()"
        },

        {
          "name": "entity.name.type.loom",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*=)"
        }

      ]
    },

    "constants": {
      "patterns": [

        {
          "name": "constant.language.boolean.loom",
          "match": "\\b(?:true|false)\\b"
        },

        {
          "name": "constant.language.null.loom",
          "match": "\\bnull\\b"
        }

      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.loom",
          "match": "==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|&&|\\|\\||[=+\\-*/%<>!&|]"
        },

        {
          "name": "punctuation.accessor.loom",
          "match": "\\."
        }
      ]
    },

    "punctuation": {
      "patterns": [

        {
          "name": "punctuation.definition.block.begin.loom",
          "match": "\\{"
        },

        {
          "name": "punctuation.definition.block.end.loom",
          "match": "\\}"
        },

        {
          "name": "punctuation.definition.parameters.begin.loom",
          "match": "\\("
        },

        {
          "name": "punctuation.definition.parameters.end.loom",
          "match": "\\)"
        },

        {
          "name": "punctuation.separator.comma.loom",
          "match": ","
        },

        {
          "name": "punctuation.terminator.statement.loom",
          "match": ";"
        }

      ]
    },

    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.loom",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}