<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="languages.pkgdef" />
    <None Remove="Language\loom-language-configuration.json" />
    <None Remove="Language\loom.tmLanguage.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="languages.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Language\loom-language-configuration.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Language\loom.tmLanguage.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <ProjectReference Include="..\Loom.Integration.LanguageServer\Loom.Integration.LanguageServer.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" IncludeInVSIX="false" />
  </ItemGroup>

  <Target Name="PublishLanguageServer" BeforeTargets="GetVsixSourceItems" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <LanguageServerPublishDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)Server\</LanguageServerPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\Loom.Integration.LanguageServer\Loom.Integration.LanguageServer.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(LanguageServerPublishDir);UseAppHost=false" />
    <ItemGroup>
      <_LanguageServerFile Include="$(LanguageServerPublishDir)**\*" Exclude="$(LanguageServerPublishDir)**\*.pdb" />
      <Content Include="@(_LanguageServerFile)">
        <IncludeInVSIX>true</IncludeInVSIX>
        <VSIXSubPath>Server\%(_LanguageServerFile.RecursiveDir)</VSIXSubPath>
      </Content>
    </ItemGroup>
  </Target>
</Project>
